<UserControl x:Class="GlassDFIR.Views.QueryHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GlassDFIR.Views"
             xmlns:controls="clr-namespace:GlassDFIR.Controls"
             xmlns:helpers="clr-namespace:GlassDFIR.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <helpers:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Browser Query History" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Text="Analysis of search queries extracted from browser history URLs." 
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Controls -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8" Margin="0,0,0,20">
            <DockPanel>
                <Button Command="{Binding LoadHistoryCommand}" 
                        Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" 
                        Padding="25,12" FontSize="14" FontWeight="Bold" 
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔎" Margin="0,0,10,0"/>
                        <TextBlock Text="Scan Browser History Results"/>
                    </StackPanel>
                </Button>
                
                <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="0,0,15,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Foreground="{StaticResource PrimaryActionBrush}" Background="{StaticResource SurfaceLightBrush}" BorderThickness="0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryActionBrush}" FontWeight="SemiBold" FontSize="14"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Results Section -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Domain Sidebar -->
            <Grid Grid.Column="0" Margin="0,0,20,0" Visibility="{Binding DomainFilters.Count, Converter={StaticResource IntToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Filter by Domain" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding DomainFilters}" 
                         SelectedValue="{Binding SelectedDomain}" SelectedValuePath="Domain"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="FilterBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4">
                                <DockPanel>
                                    <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{StaticResource PrimaryActionBrush}" FontWeight="Bold" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Domain}" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="FilterBorder" Property="Background" Value="{StaticResource PrimaryActionBrush}"/>
                                    <Setter TargetName="FilterBorder" Property="BorderBrush" Value="{StaticResource PrimaryActionBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- Results List -->
            <!-- Results List -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                             <TextBlock Text="Filter Results" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="300" HorizontalAlignment="Left" Padding="5"/>
                        <TextBlock Grid.Column="2" Text="{Binding FilteredQueries.Count, StringFormat='{}{0:N0} Results'}" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    </Grid>
                </Border>

                <controls:AdvancedDataGrid Grid.Row="1" x:Name="DataGrid"
                          ItemsSource="{Binding FilteredQueries}" 
                          GlobalFilterText="{Binding FilterText}"
                          PersistenceKey="QueryHistory">
                </controls:AdvancedDataGrid>
            </Grid>

            <!-- Empty State / No Results -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding AllQueries.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsBusy}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🔎" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="No Search Queries Found" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Run the 'Browser History' tool first, then click Scan." 
                           Foreground="{StaticResource DimmedTextBrush}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
