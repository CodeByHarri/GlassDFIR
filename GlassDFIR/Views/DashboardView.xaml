<UserControl x:Class="GlassDFIR.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GlassDFIR.Views"
             xmlns:vm="clr-namespace:GlassDFIR.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,30">
            <StackPanel>
                <TextBlock Text="Investigation Dashboard" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryActionBrush}"/>
                <TextBlock Text="Monitor activity and execute forensic tools across your environment." Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            
            <!-- Header Actions moved to Global Actions below -->
        </DockPanel>

        <!-- Prerequisites -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20" Padding="15">
            <StackPanel>
                <TextBlock Text="Prerequisites &amp; Status" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                
                <!-- EZ Tools -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔧" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Zimmerman Tools (EZ Tools)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Required for parsing artifacts (MFT, Registry, etc.)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Installed ✅" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Visibility="{Binding EzToolsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Installing..." Foreground="{StaticResource WarningBrush}" FontWeight="Bold" Visibility="{Binding IsEzInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button Command="{Binding DownloadEzToolsCommand}" Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" FontWeight="SemiBold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Download"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EzToolsInstalled}" Value="True">
                                            <Setter Property="Content" Value="Ready"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEzDownloading}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Content" Value="..."/>
                                        </DataTrigger>
                                         <DataTrigger Binding="{Binding IsEzInstalling}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Content" Value="..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Hayabusa -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🦅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Hayabusa" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Required for rapid event log analysis &amp; timeline generation." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Installed ✅" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Visibility="{Binding HayabusaInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Installing..." Foreground="{StaticResource WarningBrush}" FontWeight="Bold" Visibility="{Binding IsHayabusaInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button Command="{Binding DownloadHayabusaCommand}" Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" FontWeight="SemiBold">
                             <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Download"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HayabusaInstalled}" Value="True">
                                            <Setter Property="Content" Value="Ready"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHayabusaDownloading}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Content" Value="..."/>
                                        </DataTrigger>
                                         <DataTrigger Binding="{Binding IsHayabusaInstalling}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Content" Value="..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Volatility 3 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🧠" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Volatility 3 &amp; WinPmem" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Required for memory analysis and live memory capture." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Installed ✅" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Visibility="{Binding VolatilityInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Installing..." Foreground="{StaticResource WarningBrush}" FontWeight="Bold" Visibility="{Binding IsVolatilityInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button Command="{Binding DownloadVolatilityCommand}" Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" FontWeight="SemiBold">
                             <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Download"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VolatilityInstalled}" Value="True">
                                            <Setter Property="Content" Value="Ready"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVolatilityDownloading}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Content" Value="..."/>
                                        </DataTrigger>
                                         <DataTrigger Binding="{Binding IsVolatilityInstalling}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Content" Value="..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Global Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Run All Ready Tools" Command="{Binding RunAllCommand}" Padding="15,5" Height="36" Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" FontWeight="SemiBold"/>
            <Button Command="{Binding CreateNewCaseCommand}" 
                    Background="{StaticResource SuccessBrush}" Foreground="#1a1b26" 
                    Padding="15,5" Height="36" FontWeight="SemiBold" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💼" Margin="0,0,8,0" Foreground="#1a1b26"/>
                    <TextBlock Text="Create New Case" Foreground="#1a1b26"/>
                </StackPanel>
            </Button>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="10,0,0,0" Padding="15,5" Height="36"/>
        </StackPanel>

        <!-- Tools List -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Icon/Status -->
                                    <ColumnDefinition Width="*"/>    <!-- Info -->
                                    <ColumnDefinition Width="Auto"/> <!-- Action -->
                                </Grid.ColumnDefinitions>

                                <!-- Status Indicator -->
                                <Ellipse Width="12" Height="12" Fill="{Binding IsReady, Converter={StaticResource BooleanToBrushConverter}}" Margin="0,0,15,0" VerticalAlignment="Center"/>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        
                                        <!-- Status Tag -->
                                        <Border CornerRadius="3" BorderThickness="1" Margin="10,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                                    <Setter Property="Background" Value="#1Af7768e"/> <!-- 10% Opacity Red -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                            <Setter Property="Background" Value="#1A9ece6a"/> <!-- 10% Opacity Green -->
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="MISSING"/>
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                <Setter Property="Text" Value="READY"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- CSV Available Tag -->
                                        <Border CornerRadius="3" BorderThickness="1" Margin="10,0,0,0" Padding="6,1" VerticalAlignment="Center" 
                                                Visibility="{Binding IsCsvAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                BorderBrush="{StaticResource CsvAvailableBrush}" Background="#1Abb9af7"> <!-- 10% Opacity Purple -->
                                            <TextBlock Text="CSV AVAILABLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CsvAvailableBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ExePath}" FontSize="10" Foreground="{StaticResource DimmedTextBrush}" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Action -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="15,5" IsEnabled="{Binding IsReady}" Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" FontWeight="SemiBold">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="Configure &amp; Run"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
