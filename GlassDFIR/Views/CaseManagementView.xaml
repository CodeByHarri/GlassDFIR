<UserControl x:Class="GlassDFIR.Views.CaseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GlassDFIR.Views"
             xmlns:vm="clr-namespace:GlassDFIR.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,30">
            <StackPanel>
                <TextBlock Text="Case Management" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryActionBrush}"/>
                <TextBlock Text="Organize evidence and isolate investigative outputs." Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            
            <!-- Header simplified -->
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Case List Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="All Cases" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </Border>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding Cases}" Background="Transparent" BorderThickness="0" Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ActivateCaseCommand, RelativeSource={RelativeSource AncestorType=local:CaseManagementView}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                    <Border Background="{StaticResource WindowBackgroundBrush}" Padding="15,10" CornerRadius="6" Margin="0,2">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0"/>
                                            <Button Command="{Binding DataContext.DeleteCaseCommand, RelativeSource={RelativeSource AncestorType=local:CaseManagementView}}"
                                                    CommandParameter="{Binding}"
                                                    DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Padding="5" VerticalAlignment="Center">
                                                <TextBlock Text="🗑️" Opacity="0.5"/>
                                            </Button>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding Id, StringFormat=ID: \{0\}}" FontSize="11" Foreground="{StaticResource DimmedTextBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Case Detail View -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Visibility="{Binding ActiveCase, Converter={StaticResource NullToVisibilityConverter}}">
                    <!-- Active Case Banner -->
                    <Border Background="{StaticResource SurfaceBrush}" Padding="30" CornerRadius="12" BorderBrush="{StaticResource PrimaryActionBrush}" BorderThickness="2">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding ActiveCase.ActiveDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryActionBrush}"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Command="{Binding CloseCaseCommand}" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬅️" Margin="0,0,5,0"/>
                                            <TextBlock Text="Close Case"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenCaseFolderCommand}" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁" Margin="0,0,5,0"/>
                                            <TextBlock Text="Open Folder"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteCaseCommand}" CommandParameter="{Binding ActiveCase}" 
                                            Margin="10,0,0,0" Background="{StaticResource ErrorBrush}" Foreground="#1a1b26" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑️" Margin="0,0,5,0"/>
                                            <TextBlock Text="Delete Case"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding ActiveCase.CreatedAt, StringFormat=Created on \{0:f\}}" Foreground="{StaticResource DimmedTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Evidence Section -->
                    <TextBlock Text="Evidence Artifacts" FontSize="20" FontWeight="Bold" Margin="0,30,0,15"/>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="20" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,15">
                                <TextBlock Text="Files uploaded to Evidence folder" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <Button Command="{Binding ShowCollectionCommand}" Padding="15,5" Margin="0,0,10,0" Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" FontWeight="SemiBold" DockPanel.Dock="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" Margin="0,0,8,0" Foreground="#1a1b26"/>
                                        <TextBlock Text="Collect Evidence from this Host" Foreground="#1a1b26"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenEvidenceFolderCommand}" DockPanel.Dock="Right" Content="Upload / Add Files"/>
                                <Button Command="{Binding ScanEvidenceCommand}" DockPanel.Dock="Right" Content="🔄 Refresh" Margin="0,0,10,0"/>
                            </DockPanel>

                            <!-- Evidence Tree View -->
                            <TreeView ItemsSource="{Binding EvidenceTree}" Background="Transparent" BorderThickness="0" Margin="0,5" MaxHeight="300">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="📁" Foreground="{StaticResource FolderBrush}" Visibility="{Binding IsDirectory, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,5,0"/>
                                            <TextBlock Text="📄" Foreground="{StaticResource PrimaryTextBrush}" Visibility="{Binding IsDirectory, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding DisplaySize}" Foreground="{StaticResource DimmedTextBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="False"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>

                            <TextBlock Text="No evidence files found yet. Drag files into the Evidence folder to get started." 
                                     Foreground="{StaticResource DimmedTextBrush}" FontStyle="Italic"
                                     Visibility="{Binding EvidenceTree.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}" 
                                     HorizontalAlignment="Center" Margin="0,20"/>
                        </StackPanel>
                    </Border>

                    <!-- Generated Artifacts Section -->
                    <TextBlock Text="Generated Forensic Artifacts" FontSize="20" FontWeight="Bold" Margin="0,30,0,15"/>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="20" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,15">
                                <TextBlock Text="CSVs generated for this case" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <Button Command="{Binding ScanGeneratedCsvsCommand}" DockPanel.Dock="Right" Content="🔄 Refresh Status" Margin="0,0,10,0"/>
                            </DockPanel>

                            <ListBox ItemsSource="{Binding GeneratedCsvs}" Background="Transparent" BorderThickness="0" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="📊" Margin="0,0,10,0" Foreground="{StaticResource CsvAvailableBrush}"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding LastWriteTime, StringFormat=\{0:g\}}" DockPanel.Dock="Right" Foreground="{StaticResource DimmedTextBrush}" FontSize="11"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No forensic outputs generated yet. Run a recommended tool below to start." 
                                     Foreground="{StaticResource DimmedTextBrush}" FontStyle="Italic"
                                     Visibility="{Binding GeneratedCsvs.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}" 
                                     HorizontalAlignment="Center" Margin="0,20"/>
                        </StackPanel>
                    </Border>

                    <!-- Recommendations -->
                    <TextBlock Text="Recommended Actions" FontSize="20" FontWeight="Bold" Margin="0,30,0,15"/>
                    <ItemsControl ItemsSource="{Binding RecommendedTools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" Margin="0,0,0,10" Padding="15" CornerRadius="6" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1,1,1,1">
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ToolName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock Text="{Binding Reason}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <Button Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=local:CaseManagementView}}" 
                                                CommandParameter="{Binding Tool}"
                                                DockPanel.Dock="Right" Padding="20,8" VerticalAlignment="Center"
                                                Background="{StaticResource SuccessBrush}" Foreground="#1a1b26" FontWeight="Bold">
                                            <TextBlock Text="Run Investigation" Foreground="#1a1b26"/>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- No Case Selected State -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ActiveCase, Converter={StaticResource InverseNullToVisibilityConverter}}">
                <TextBlock Text="💼" FontSize="64" HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="No Active Case" FontSize="24" FontWeight="Bold" Margin="0,20,0,10"/>
                <TextBlock Text="Create or select a case to begin isolated analysis." Foreground="{StaticResource SecondaryTextBrush}"/>
                <Button Command="{Binding CreateNewCaseCommand}" Margin="0,20,0,0" Padding="30,12" 
                        Background="{StaticResource SuccessBrush}" Foreground="#1a1b26" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💼" Margin="0,0,10,0" Foreground="#1a1b26"/>
                        <TextBlock Text="Create New Case" Foreground="#1a1b26"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Evidence Collection Overlay -->
            <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#CC1a1b26" 
                  Visibility="{Binding ShowCollectionOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Width="900" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Collect Host Evidence" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <!-- Admin Warning -->
                            <Border Background="{StaticResource WarningBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <Button Command="{Binding RestartAsAdminCommand}" DockPanel.Dock="Right" Padding="10,5" Background="Transparent" BorderBrush="#1a1b26" BorderThickness="1" Foreground="#1a1b26" FontWeight="Bold">
                                        <TextBlock Text="Restart as Admin"/>
                                    </Button>
                                    <TextBlock Text="⚠️" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#1a1b26"/>
                                    <TextBlock Text="Application is not running as Administrator. VSS snapshots and locked files (Registry, MFT) will fail to collect." 
                                               FontWeight="SemiBold" Foreground="#1a1b26" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Select forensic artifacts to collect into the case evidence folder. Some items require administrative privileges and VSS." 
                                       TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Profiles Sidebar -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="0,0,15,0" Padding="0,0,15,0">
                                <DockPanel>
                                    <TextBlock Text="User Profiles" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ListBox ItemsSource="{Binding AvailableProfiles}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          Command="{Binding DataContext.RefreshArtifactsCommand, RelativeSource={RelativeSource AncestorType=local:CaseManagementView}}"
                                                          Margin="0,2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Artifacts List -->
                            <ScrollViewer Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding AvailableArtifacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ToolRecommendation}" FontSize="10" Foreground="{StaticResource SuccessBrush}"/>
                                                            <TextBlock Text=" • VSS" FontSize="10" Foreground="{StaticResource ErrorBrush}" Visibility="{Binding RequiresVss, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="{StaticResource DimmedTextBrush}" HorizontalAlignment="Right"/>
                                                        <!-- Status Indicator could go here if needed, but SizeDisplay covers it textually -->
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Progress Section -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,20" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding CollectionStatus}" FontSize="12" Margin="0,0,0,5"/>
                            <ProgressBar Height="8" Value="{Binding CollectionProgress}" Maximum="100"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelCollectionCommand}" Width="100" Padding="10" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="Execute Collection" Command="{Binding ExecuteCollectionCommand}" 
                                    Background="{StaticResource SuccessBrush}" Foreground="#1a1b26" FontWeight="Bold"
                                    Width="160" Padding="10" Margin="10,0,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
