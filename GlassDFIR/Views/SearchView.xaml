<UserControl x:Class="GlassDFIR.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GlassDFIR.Views"
             xmlns:helpers="clr-namespace:GlassDFIR.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,20" CornerRadius="4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Search" Command="{Binding PerformSearchCommand}" Padding="20,8" Margin="10,0,0,0" IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBooleanConverter}}" Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" FontSize="16" Padding="5" Foreground="{StaticResource PrimaryTextBrush}" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource PrimaryTextBrush}"/>
            </DockPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Stats & Progress -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding ResultCount, StringFormat='Found {0} results'}" Foreground="{StaticResource SecondaryTextBrush}" Visibility="{Binding ResultCount, Converter={StaticResource IntToVisibilityConverter}}"/>
                    
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource PrimaryActionBrush}" Background="{StaticResource SurfaceLightBrush}" BorderThickness="0"/>
                        <TextBlock Text="Searching across all CSVs..." Foreground="{StaticResource PrimaryActionBrush}" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{Binding MatchedSourcesSummary}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding MatchedSourcesSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Source Filters -->
            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding SourceFilters}" 
                     SelectedValue="{Binding SelectedSource}"
                     SelectedValuePath="Name"
                     Background="Transparent" 
                     BorderThickness="0" 
                     Margin="0,0,0,15"
                     Visibility="{Binding ResultCount, Converter={StaticResource IntToVisibilityConverter}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ChipBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Count}" Foreground="{StaticResource PrimaryActionBrush}" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource PrimaryActionBrush}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource PrimaryActionBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Results List -->
            <ListBox Grid.Row="2" 
                     ItemsSource="{Binding FilteredResults}" 
                     Background="Transparent" 
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Visibility="{Binding ResultCount, Converter={StaticResource IntToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.GoToResultCommand, RelativeSource={RelativeSource AncestorType=local:SearchView}}" 
                                CommandParameter="{Binding}"
                                Padding="0" Margin="0,0,0,10" 
                                Background="Transparent" BorderThickness="0">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="4">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding ToolName}" Foreground="{StaticResource PrimaryActionBrush}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LineReference}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    
                                    <TextBlock Text="{Binding Source}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,8"/>
                                    
                                    <Border Background="{StaticResource WindowBackgroundBrush}" Padding="10" CornerRadius="2">
                                        <TextBlock TextWrapping="Wrap" FontFamily="Consolas">
                                            <Run Text="..." Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <Run Text="{Binding MatchContextBefore}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Run Text="{Binding DataContext.SearchQuery, RelativeSource={RelativeSource AncestorType=local:SearchView}}" Foreground="#ff9e64" FontWeight="Bold"/>
                                            <Run Text="{Binding MatchContextAfter}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Run Text="..." Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- No Results Message -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ResultCount}" Value="0"/>
                                    <Condition Binding="{Binding SearchPerformed}" Value="True"/>
                                    <Condition Binding="{Binding IsSearching}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="No results found." FontSize="24" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Try a different query or a more generic regex pattern." Margin="0,10,0,0" Foreground="{StaticResource DimmedTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
