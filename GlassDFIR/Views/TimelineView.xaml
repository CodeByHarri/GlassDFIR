<UserControl x:Class="GlassDFIR.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GlassDFIR.Views"
             xmlns:controls="clr-namespace:GlassDFIR.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <TextBlock Text="{Binding HeaderText}" FontSize="24" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Manage Formatting" Click="ManageRules_Click" Padding="15,5" Margin="10,0,0,0" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryTextBrush}"/>
                <Button Content="Interesting Entities" Command="{Binding ShowInterestingEntitiesCommand}" Padding="15,5" Margin="10,0,0,0" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryTextBrush}"/>
                <Button Content="Export to CSV (Filtered)" Click="ExportFiltered_Click" Padding="15,5" Margin="10,0,0,0" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource PrimaryTextBrush}"/>
                <Button Content="Load CSV Manually" Command="{Binding BrowseCsvCommand}" Padding="15,5" Margin="10,0,0,0" Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                     <TextBlock Text="Filter Results" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                     <TextBlock Text="{Binding ResultCount, ElementName=DataGrid, StringFormat='({0:N0} Results)'}" 
                                Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="300" HorizontalAlignment="Left" Padding="5"/>
                <TextBlock Grid.Column="2" Text="{Binding CurrentFilePath, TargetNullValue='No file loaded'}" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <!-- Empty State Placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Results, Converter={StaticResource InverseNullToVisibilityConverter}}">
                <TextBlock Text="{Binding Icon}" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding HeaderText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ToolName, StringFormat='Run {0} from the Dashboard or load a CSV manually.'}" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                <Button Content="{Binding ToolName, StringFormat='Browse for {0} CSV'}" Command="{Binding BrowseCsvCommand}" Margin="0,20,0,0" Padding="20,10"/>
            </StackPanel>

            <controls:AdvancedDataGrid x:Name="DataGrid"
                Visibility="{Binding Results, Converter={StaticResource NullToVisibilityConverter}}"
                ItemsSource="{Binding ResultsView}"
                GlobalFilterText="{Binding FilterText}"
                PersistenceKey="{Binding ToolName}"/>

            <Border Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="{Binding LoadingMessage}" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
