<UserControl x:Class="GlassDFIR.Views.RapidSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GlassDFIR.Views"
             xmlns:helpers="clr-namespace:GlassDFIR.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <helpers:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Popular Rapid Searches" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Text="Automated pattern extraction and external intelligence enrichment for rapid triage." 
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Controls -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8" Margin="0,0,0,20">
            <DockPanel>
                <Button Command="{Binding RunAsnLookupCommand}" 
                        Background="{StaticResource PrimaryActionBrush}" Foreground="#1a1b26" 
                        Padding="25,12" FontSize="14" FontWeight="Bold" 
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,10,0"/>
                        <TextBlock Text="Identify Foreign IP Addresses &amp; ASNs"/>
                    </StackPanel>
                </Button>
                
                <StackPanel Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="0,0,15,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Foreground="{StaticResource PrimaryActionBrush}" Background="{StaticResource SurfaceLightBrush}" BorderThickness="0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryActionBrush}" FontWeight="SemiBold" FontSize="14"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Results Section -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ASN Sidebar -->
            <Grid Grid.Column="0" Margin="0,0,20,0" Visibility="{Binding AsnFilters.Count, Converter={StaticResource IntToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Found ASNs" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding AsnFilters}" 
                         SelectedValue="{Binding SelectedAsn}" SelectedValuePath="Name"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="FilterBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,4">
                                <DockPanel>
                                    <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{StaticResource PrimaryActionBrush}" FontWeight="Bold" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="FilterBorder" Property="Background" Value="{StaticResource PrimaryActionBrush}"/>
                                    <Setter TargetName="FilterBorder" Property="BorderBrush" Value="{StaticResource PrimaryActionBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- Results List -->
            <ListBox Grid.Column="1" 
                     ItemsSource="{Binding FilteredResults}" 
                     Background="Transparent" 
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Visibility="{Binding Results.Count, Converter={StaticResource IntToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.GoToResultCommand, RelativeSource={RelativeSource AncestorType=local:RapidSearchView}}" 
                                CommandParameter="{Binding}"
                                Padding="0" Margin="0,0,0,12" 
                                Background="Transparent" BorderThickness="0">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding IP}" Foreground="{StaticResource PrimaryActionBrush}" FontWeight="Bold" FontSize="18"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource WindowBackgroundBrush}" Padding="10,4" CornerRadius="12">
                                            <TextBlock Text="{Binding ASN}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DockPanel>
                                    
                                    <TextBlock Text="{Binding ASNName}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    
                                    <DockPanel Margin="0,10,0,10">
                                        <TextBlock Text="{Binding ToolName}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding LineReference}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding Source}" DockPanel.Dock="Right" Foreground="{StaticResource DimmedTextBrush}" FontSize="11"/>
                                    </DockPanel>
                                    
                                    <Border Background="{StaticResource WindowBackgroundBrush}" Padding="15" CornerRadius="4">
                                        <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12">
                                            <Run Text="..." Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <Run Text="{Binding MatchContextBefore}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Run Text="{Binding IP}" Foreground="#ff9e64" FontWeight="Bold"/>
                                            <Run Text="{Binding MatchContextAfter}" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Run Text="..." Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Empty State / No Results -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Results.Count}" Value="0"/>
                                    <Condition Binding="{Binding SearchPerformed}" Value="True"/>
                                    <Condition Binding="{Binding IsBusy}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📡" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="No Results Found" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="No foreign (external) IP addresses were identified in the scanned evidence." 
                           Foreground="{StaticResource DimmedTextBrush}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Initial State -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SearchPerformed}" Value="False"/>
                                    <Condition Binding="{Binding IsBusy}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="⚡" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="Rapid IP Triage" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Click the scan button above to search all tool outputs for foreign IP addresses." 
                           Foreground="{StaticResource DimmedTextBrush}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
